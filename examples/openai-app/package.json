    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/lodash.merge": "4.6.9",
    "@types/react": "18.3.7",
    "@types/react-dom": "18.3.2",
    "@vitejs/plugin-react": "4.2.1",
    "typescript": "5.6.3",
    "vite": "5.3.3"
  }
}
